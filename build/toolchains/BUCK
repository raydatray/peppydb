# Toolchains used by the build. rustc, clippy-driver, and rustdoc come from
# PATH through rustup, which pins them with rust-toolchain.toml. The C compiler,
# which rustc uses as its linker, comes from PATH. Go is a pinned download, and
# so is the nightly Rust toolchain that `@build/mode/miri` uses.

load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "remote_python_toolchain", "system_python_bootstrap_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@prelude//toolchains/go:go_bootstrap_toolchain.bzl", "go_bootstrap_distr", "go_bootstrap_toolchain")
load("@prelude//toolchains/go:go_toolchain.bzl", "go_distr", "go_toolchain")
load(":host.bzl", "by_host")
load(":miri_nightly.bzl", "MIRI_COMPONENTS", "MIRI_RUST_SRC")
load(":rust.bzl", "peppy_rust_toolchain")

# Cargo's default release profile. Applies to every crate, third-party included.
RELEASE_FLAGS = [
    "-Copt-level=3",
    "-Cdebug-assertions=off",
    "-Coverflow-checks=off",
]

peppy_rust_toolchain(
    name = "rust",
    default_edition = "2024",
    # `-Dunsafe_code` is `[workspace.lints.rust] unsafe_code = "deny"`. Deny,
    # not forbid, so that a crate on the tools/check-unsafe allowlist can opt
    # in with `#![allow(unsafe_code)]`. Third-party crates are built with
    # `--cap-lints=allow` by the prelude and are not affected.
    rustc_flags = ["-Dunsafe_code"] + select({
        "root//build:mode-release": RELEASE_FLAGS,
        "DEFAULT": [],
    }),
    # `cargo clippy -- -D warnings`. Also makes warnings fail normal builds.
    deny_lints = ["warnings"],
    doctests = True,
    # In Miri mode, build procedural macros and build scripts with the nightly
    # too: require the execution platform that carries mode-miri.
    exec_compatible_with = select({
        "root//build:mode-miri": ["root//build:mode-miri"],
        "DEFAULT": [],
    }),
    # Only `@build/mode/miri` uses the nightly; other modes never download it.
    miri_sysroot = select({
        "root//build:mode-miri": ":miri-sysroot",
        "DEFAULT": None,
    }),
    nightly = select({
        "root//build:mode-miri": ":rust-nightly",
        "DEFAULT": None,
    }),
    visibility = ["PUBLIC"],
)

# The nightly Rust toolchain for Miri, pinned by tools/update-miri. Each
# component is a sha256-checked archive for the host; rust-src is the same on
# every host.
[
    http_archive(
        name = "rust-nightly-{}-{}".format(component, host),
        urls = [archive["url"]],
        sha256 = archive["sha256"],
        strip_prefix = archive["strip_prefix"],
    )
    for host, components in MIRI_COMPONENTS.items()
    for component, archive in components.items()
]

http_archive(
    name = "rust-nightly-src",
    urls = [MIRI_RUST_SRC["url"]],
    sha256 = MIRI_RUST_SRC["sha256"],
    strip_prefix = MIRI_RUST_SRC["strip_prefix"],
)

# One toolchain directory (bin/, lib/, lib/rustlib/...), as rustup lays it out.
genrule(
    name = "rust-nightly",
    out = "dist",
    cmd = by_host({
        host: " && ".join(["mkdir -p $OUT"] + [
            "cp -R $(location :rust-nightly-{}-{})/. $OUT/".format(component, host)
            for component in sorted(components)
        ] + ["cp -R $(location :rust-nightly-src)/. $OUT/"])
        for host, components in MIRI_COMPONENTS.items()
    }),
)

# Miri's standard library, built with MIR for every function. `cargo miri
# setup` compiles it from rust-src and downloads the standard library's
# crates.io dependencies, so this action needs network access on its first
# run; Buck2 caches the result.
genrule(
    name = "miri-sysroot",
    out = "sysroot",
    # The scratch directory must be outside the repository: under buck-out,
    # Cargo would find the repository's Cargo.toml and treat the generated
    # sysroot package as part of that workspace.
    cmd = " ".join([
        "dist=$(location :rust-nightly) &&",
        "scratch=`mktemp -d /tmp/peppydb-miri-sysroot.XXXXXX` &&",
        "trap 'rm -rf $scratch' EXIT &&",
        "env -i HOME=$scratch TMPDIR=$scratch PATH=$dist/bin:/usr/bin:/bin",
        "CARGO_HOME=$scratch/cargo-home RUSTC=$dist/bin/rustc MIRI_SYSROOT=$OUT",
        "$dist/bin/cargo miri setup",
    ]),
)

system_cxx_toolchain(
    name = "cxx",
    visibility = ["PUBLIC"],
)

# Only referenced by an unconfigured select() branch in the prelude. Without
# it, whole-repository `uquery` fails.
alias(
    name = "cxx_no_default_deps",
    actual = ":cxx",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    visibility = ["PUBLIC"],
)

remote_python_toolchain(
    name = "python",
    bootstrap = False,
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

# Go: the official release for the host, downloaded and checked by sha256.
# GO_VERSION must match go/go.mod; tools/check-tools checks it.
GO_VERSION = "1.27.0"

GO_RELEASES = {
    # name: (GOOS, GOARCH, sha256)
    "darwin-arm64": ("darwin", "arm64", "90493b3bbd5e10f91d12153198bf1994fd756399b4fec93b49b0c6e2acdeeb3e"),
    "linux-amd64": ("linux", "amd64", "675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685"),
    "linux-arm64": ("linux", "arm64", "51798d2c42d0e1c6ed7fd9f48728b4193abac9e8aad6dbac2fe96a81f5909bda"),
}

[
    http_archive(
        name = "go-" + name,
        urls = ["https://go.dev/dl/go{}.{}.tar.gz".format(GO_VERSION, name)],
        sha256 = sha256,
        strip_prefix = "go",
    )
    for name, (_, _, sha256) in GO_RELEASES.items()
]

GO_ROOT = by_host({name: ":go-" + name for name in GO_RELEASES})

# The pinned Go distribution for this host; tools/fmt.sh runs its gofmt.
alias(
    name = "go-root",
    actual = GO_ROOT,
    visibility = ["PUBLIC"],
)
GO_OS = by_host({name: goos for name, (goos, _, _) in GO_RELEASES.items()})
GO_ARCH = by_host({name: goarch for name, (_, goarch, _) in GO_RELEASES.items()})

go_distr(
    name = "go-distr",
    go_os_arch = by_host({name: (goos, goarch) for name, (goos, goarch, _) in GO_RELEASES.items()}),
    go_root = GO_ROOT,
    # The prelude passes `-std` to the assembler for the standard library only
    # when it knows the Go version is 1.27 or later.
    version = GO_VERSION,
)

go_toolchain(
    name = "go",
    env_go_arch = GO_ARCH,
    env_go_os = GO_OS,
    go_distr = ":go-distr",
    visibility = ["PUBLIC"],
)

# Builds the prelude's own Go helper tools, with the same Go.
go_bootstrap_distr(
    name = "go-bootstrap-distr",
    go_os_arch = by_host({name: (goos, goarch) for name, (goos, goarch, _) in GO_RELEASES.items()}),
    go_root = GO_ROOT,
)

go_bootstrap_toolchain(
    name = "go_bootstrap",
    env_go_arch = GO_ARCH,
    env_go_os = GO_OS,
    go_bootstrap_distr = ":go-bootstrap-distr",
    visibility = ["PUBLIC"],
)
