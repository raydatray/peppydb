# Toolchains used by the build. Stable Rust, Miri nightly Rust (and its stdlib
# crates), Go, and Python are pinned downloads verified by sha256 on every host.
# On Linux, C/C++ linking uses pinned LLVM and a Debian Bullseye sysroot. On
# macOS, C/C++ linking uses host Xcode CLT (Apple's MacOSX.sdk cannot be
# redistributed).

load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:cxx.bzl", "cxx_tools_info_toolchain")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "remote_python_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load("@prelude//toolchains/go:go_bootstrap_toolchain.bzl", "go_bootstrap_distr", "go_bootstrap_toolchain")
load("@prelude//toolchains/go:go_toolchain.bzl", "go_distr", "go_toolchain")
load(":cxx.bzl", "llvm_cxx_tools")
load(":go.bzl", "GO_RELEASES", "GO_VERSION")
load(":host.bzl", "by_host")
load(":llvm.bzl", "LINUX_SYSROOTS", "LLVM_RELEASES")
load(":miri_nightly.bzl", "MIRI_COMPONENTS", "MIRI_RUST_SRC", "MIRI_STD_CRATES")
load(":rust.bzl", "peppy_rust_toolchain")
load(":rust_stable.bzl", "RUST_COMPONENTS", "RUST_SRC")

# Cargo's default release profile. Applies to every crate, third-party included.
RELEASE_FLAGS = [
    "-Copt-level=3",
    "-Cdebug-assertions=off",
    "-Coverflow-checks=off",
]

# For `@build/mode/profile` (plan 0024): symbols, inlined frames, and source
# lines for profilers, and frame pointers for cheap stack walks. Frame
# pointers change the code slightly, so reference numbers come only from
# release builds.
PROFILE_FLAGS = [
    "-Cdebuginfo=line-tables-only",
    "-Cforce-frame-pointers=yes",
]

peppy_rust_toolchain(
    name = "rust",
    default_edition = "2024",
    # `-Dunsafe_code` is `[workspace.lints.rust] unsafe_code = "deny"`. Deny,
    # not forbid, so that a crate on the tools/check-unsafe allowlist can opt
    # in with `#![allow(unsafe_code)]`. Third-party crates are built with
    # `--cap-lints=allow` by the prelude and are not affected.
    rustc_flags = ["-Dunsafe_code"] + select({
        "root//build:mode-release": RELEASE_FLAGS,
        "root//build:mode-profile": RELEASE_FLAGS + PROFILE_FLAGS,
        "DEFAULT": [],
    }),
    # `cargo clippy -- -D warnings`. Also makes warnings fail normal builds.
    deny_lints = ["warnings"],
    doctests = True,
    # In Miri mode, build procedural macros and build scripts with the nightly
    # too: require the execution platform that carries mode-miri.
    exec_compatible_with = select({
        "root//build:mode-miri": ["root//build:mode-miri"],
        "DEFAULT": [],
    }),
    # Default builds use pinned stable Rust; `@build/mode/miri` switches to the
    # pinned nightly so procedural macros match the Miri driver.
    dist = select({
        "root//build:mode-miri": ":rust-nightly",
        "DEFAULT": ":rust-stable",
    }),
    miri_sysroot = select({
        "root//build:mode-miri": ":miri-sysroot",
        "DEFAULT": None,
    }),
    visibility = ["PUBLIC"],
)

# The stable Rust toolchain, pinned by tools/update-rust. Each component is a
# sha256-checked archive for the host; rust-src is the same on every host.
[
    http_archive(
        name = "rust-stable-{}-{}".format(component, host),
        urls = [archive["url"]],
        sha256 = archive["sha256"],
        strip_prefix = archive["strip_prefix"],
    )
    for host, components in RUST_COMPONENTS.items()
    for component, archive in components.items()
]

http_archive(
    name = "rust-stable-src",
    urls = [RUST_SRC["url"]],
    sha256 = RUST_SRC["sha256"],
    strip_prefix = RUST_SRC["strip_prefix"],
)

# One toolchain directory (bin/, lib/, lib/rustlib/...), as rustup lays it out.
genrule(
    name = "rust-stable",
    out = "dist",
    cmd = by_host({
        host: " && ".join(["mkdir -p $OUT"] + [
            "cp -R $(location :rust-stable-{}-{})/. $OUT/".format(component, host)
            for component in sorted(components)
        ] + ["cp -R $(location :rust-stable-src)/. $OUT/"])
        for host, components in RUST_COMPONENTS.items()
    }),
)

# The pinned stable Rust distribution for this host; tools/fmt.sh and
# tools/autocargo run its rustfmt and cargo.
alias(
    name = "rust-root",
    actual = ":rust-stable",
    visibility = ["PUBLIC"],
)

# The nightly Rust toolchain for Miri, pinned by tools/update-miri. Each
# component is a sha256-checked archive for the host; rust-src is the same on
# every host.
[
    http_archive(
        name = "rust-nightly-{}-{}".format(component, host),
        urls = [archive["url"]],
        sha256 = archive["sha256"],
        strip_prefix = archive["strip_prefix"],
    )
    for host, components in MIRI_COMPONENTS.items()
    for component, archive in components.items()
]

http_archive(
    name = "rust-nightly-src",
    urls = [MIRI_RUST_SRC["url"]],
    sha256 = MIRI_RUST_SRC["sha256"],
    strip_prefix = MIRI_RUST_SRC["strip_prefix"],
)

# One toolchain directory (bin/, lib/, lib/rustlib/...), as rustup lays it out.
genrule(
    name = "rust-nightly",
    out = "dist",
    cmd = by_host({
        host: " && ".join(["mkdir -p $OUT"] + [
            "cp -R $(location :rust-nightly-{}-{})/. $OUT/".format(component, host)
            for component in sorted(components)
        ] + ["cp -R $(location :rust-nightly-src)/. $OUT/"])
        for host, components in MIRI_COMPONENTS.items()
    }),
)

# Crates from rust-src's library/Cargo.lock, pinned by tools/update-miri so
# `:miri-sysroot` builds completely offline.
[
    http_archive(
        name = "miri-std-{}-{}".format(crate["name"], crate["version"]),
        urls = ["https://static.crates.io/crates/{name}/{name}-{version}.crate".format(**crate)],
        sha256 = crate["sha256"],
        type = "tar.gz",
        strip_prefix = "{name}-{version}".format(**crate),
    )
    for crate in MIRI_STD_CRATES
]

# Miri's standard library, built with MIR for every function. `cargo miri
# setup` compiles it offline from rust-src and the pinned MIRI_STD_CRATES
# archives; on Linux it links build scripts with the pinned LLVM + sysroot so
# no host C compiler is needed. Buck2 caches the result.
_MIRI_COMMON_SETUP = [
    "repo=`pwd`",
    "dist=$(location :rust-nightly)",
    "scratch=`mktemp -d /tmp/peppydb-miri-sysroot.XXXXXX`",
    "trap 'rm -rf $scratch' EXIT",
    "mkdir -p $scratch/cargo-home $scratch/vendor",
] + [
    "cp -R $(location :miri-std-{name}-{version}) $scratch/vendor/{name}-{version} && printf '{{\"files\":{{}},\"package\":\"{sha256}\"}}' > $scratch/vendor/{name}-{version}/.cargo-checksum.json".format(**crate)
    for crate in MIRI_STD_CRATES
] + [
    "printf '[source.crates-io]\\nreplace-with = \"vendored-sources\"\\n[source.vendored-sources]\\ndirectory = \"%s/vendor\"\\n' \"$scratch\" > $scratch/cargo-home/config.toml",
]

_MIRI_LINUX_HOSTS = {
    "linux-amd64": "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER",
    "linux-arm64": "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER",
}

genrule(
    name = "miri-sysroot",
    out = "sysroot",
    # The scratch directory must be outside the repository: under buck-out,
    # Cargo would find the repository's Cargo.toml and treat the generated
    # sysroot package as part of that workspace.
    cmd = by_host(dict(
        [
            (
                "darwin-arm64",
                " && ".join(_MIRI_COMMON_SETUP + [
                    "env -i HOME=$scratch TMPDIR=$scratch PATH=$dist/bin:/usr/bin:/bin CARGO_HOME=$scratch/cargo-home CARGO_NET_OFFLINE=true RUSTC=$dist/bin/rustc MIRI_SYSROOT=$OUT $dist/bin/cargo miri setup",
                ]),
            ),
        ] + [
            (
                host,
                " && ".join(_MIRI_COMMON_SETUP + [
                    "llvm=$repo/$(location :llvm-{})".format(host),
                    "sysroot=$repo/$(location :sysroot-{})".format(host),
                    "printf '#!/bin/sh\\nexec \"%s/bin/clang++\" --sysroot=\"%s\" -fuse-ld=lld -B\"%s/bin\" \"$@\"\\n' \"$llvm\" \"$sysroot\" \"$llvm\" > $scratch/cc",
                    "chmod +x $scratch/cc",
                    "env -i HOME=$scratch TMPDIR=$scratch PATH=$dist/bin:/usr/bin:/bin CC=$scratch/cc CXX=$scratch/cc AR=$llvm/bin/llvm-ar {}=$scratch/cc CARGO_HOME=$scratch/cargo-home CARGO_NET_OFFLINE=true RUSTC=$dist/bin/rustc MIRI_SYSROOT=$OUT $dist/bin/cargo miri setup".format(linker_env),
                ]),
            )
            for host, linker_env in _MIRI_LINUX_HOSTS.items()
        ],
    )),
)

# Pinned LLVM + Chromium Debian Bullseye sysroot for hermetic Linux linking.
[
    http_archive(
        name = "llvm-" + host,
        urls = [archive["url"]],
        sha256 = archive["sha256"],
        strip_prefix = archive["strip_prefix"],
    )
    for host, archive in LLVM_RELEASES.items()
]

# The sysroot ships systemd unit files such as
# `system-systemd\x2dcryptsetup.slice`. Buck2 rejects a backslash in an output
# path, and a C/C++ sysroot needs no systemd units, so skip that directory.
[
    http_archive(
        name = "sysroot-" + host,
        urls = [archive["url"]],
        sha256 = archive["sha256"],
        type = "tar.xz",
        excludes = [r"\./lib/systemd/"],
    )
    for host, archive in LINUX_SYSROOTS.items()
]

llvm_cxx_tools(
    name = "llvm-cxx-tools",
    llvm = select({
        "config//cpu:arm64": ":llvm-linux-arm64",
        "DEFAULT": ":llvm-linux-amd64",
    }),
    sysroot = select({
        "config//cpu:arm64": ":sysroot-linux-arm64",
        "DEFAULT": ":sysroot-linux-amd64",
    }),
)

cxx_tools_info_toolchain(
    name = "cxx",
    cxx_tools_info = select({
        "config//os:linux": ":llvm-cxx-tools",
        "config//os:macos": "prelude//toolchains/cxx/clang:path_clang_tools",
    }),
    visibility = ["PUBLIC"],
)

# Only referenced by an unconfigured select() branch in the prelude. Without
# it, whole-repository `uquery` fails.
alias(
    name = "cxx_no_default_deps",
    actual = ":cxx",
    visibility = ["PUBLIC"],
)

system_genrule_toolchain(
    name = "genrule",
    visibility = ["PUBLIC"],
)

remote_python_toolchain(
    name = "python",
    bootstrap = True,
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(
    name = "remote_test_execution",
    visibility = ["PUBLIC"],
)

noop_test_toolchain(
    name = "test",
    visibility = ["PUBLIC"],
)

# Go: the official release for the host, downloaded and checked by sha256,
# pinned by tools/update-go in go.bzl. GO_VERSION must match go.mod;
# tools/check-tools checks it.

[
    http_archive(
        name = "go-" + name,
        urls = ["https://go.dev/dl/go{}.{}.tar.gz".format(GO_VERSION, name)],
        sha256 = sha256,
        strip_prefix = "go",
    )
    for name, (_, _, sha256) in GO_RELEASES.items()
]

GO_ROOT = by_host({name: ":go-" + name for name in GO_RELEASES})

# The pinned Go distribution for this host; tools/fmt.sh runs its gofmt.
alias(
    name = "go-root",
    actual = GO_ROOT,
    visibility = ["PUBLIC"],
)
GO_OS = by_host({name: goos for name, (goos, _, _) in GO_RELEASES.items()})
GO_ARCH = by_host({name: goarch for name, (_, goarch, _) in GO_RELEASES.items()})

go_distr(
    name = "go-distr",
    go_os_arch = by_host({name: (goos, goarch) for name, (goos, goarch, _) in GO_RELEASES.items()}),
    go_root = GO_ROOT,
    # The prelude passes `-std` to the assembler for the standard library only
    # when it knows the Go version is 1.27 or later.
    version = GO_VERSION,
)

go_toolchain(
    name = "go",
    env_go_arch = GO_ARCH,
    env_go_os = GO_OS,
    # On Linux, cgo links through the pinned LLVM against the Debian Bullseye
    # sysroot (glibc 2.31). There, pthread and the DNS resolver functions are
    # in libpthread and libresolv, not in libc (glibc merged them in 2.34).
    # `go build` passes `-lpthread` (runtime/cgo) and `-lresolv` (net) from the
    # standard library's `#cgo LDFLAGS`, but the prelude's Go link does not, so
    # add them after the objects here.
    external_linker_flags = select({
        "config//os:linux": [
            "-lpthread",
            "-lresolv",
        ],
        "DEFAULT": [],
    }),
    go_distr = ":go-distr",
    visibility = ["PUBLIC"],
)

# Builds the prelude's own Go helper tools, with the same Go.
go_bootstrap_distr(
    name = "go-bootstrap-distr",
    go_os_arch = by_host({name: (goos, goarch) for name, (goos, goarch, _) in GO_RELEASES.items()}),
    go_root = GO_ROOT,
)

go_bootstrap_toolchain(
    name = "go_bootstrap",
    env_go_arch = GO_ARCH,
    env_go_os = GO_OS,
    go_bootstrap_distr = ":go-bootstrap-distr",
    visibility = ["PUBLIC"],
)
