# Build configuration: the build_mode setting and the platforms that use it.

load("@prelude//platforms:defs.bzl", "host_configuration")
load(":platforms.bzl", "peppy_execution_platform", "peppy_execution_platforms")

# Debug, release, or Miri. The Rust toolchain selects its optimization flags
# and, for Miri, a nightly compiler on this.
constraint_setting(name = "build_mode")

constraint_value(
    name = "mode-debug",
    constraint_setting = ":build_mode",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "mode-release",
    constraint_setting = ":build_mode",
    visibility = ["PUBLIC"],
)

# Debug flags with the pinned nightly toolchain and its Miri driver. Every
# rust_test gets a `[miri]` sub-target in this mode.
constraint_value(
    name = "mode-miri",
    constraint_setting = ":build_mode",
    visibility = ["PUBLIC"],
)

# The host platform with release flags: `buck2 ... @build/mode/release`.
# Release outputs get their own configuration, so they are cached separately
# from debug outputs.
platform(
    name = "release",
    constraint_values = [":mode-release"],
    deps = ["prelude//platforms:default"],
    visibility = ["PUBLIC"],
)

# The host platform with the nightly toolchain and Miri:
# `buck2 test @build/mode/miri '<test>[miri]'`.
platform(
    name = "miri",
    constraint_values = [":mode-miri"],
    deps = ["prelude//platforms:default"],
    visibility = ["PUBLIC"],
)

# Linux on x86_64, as on GitHub's runners. Used to check from other hosts that
# the configured graph (including platform-specific Go dependencies) resolves.
platform(
    name = "linux-x86_64",
    constraint_values = [
        "config//cpu/constraints:x86_64",
        "config//os/constraints:linux",
    ],
    deps = ["prelude//platforms:default"],
    visibility = ["PUBLIC"],
)

# Execution platforms (see platforms.bzl). The plain host comes first, so every
# mode except Miri builds its tools exactly as with the prelude's default.
peppy_execution_platform(
    name = "exec-host",
    constraints = [host_configuration.cpu, host_configuration.os],
)

peppy_execution_platform(
    name = "exec-host-miri",
    constraints = [host_configuration.cpu, host_configuration.os, ":mode-miri"],
)

peppy_execution_platforms(
    name = "execution-platforms",
    platforms = [":exec-host", ":exec-host-miri"],
    visibility = ["PUBLIC"],
)
