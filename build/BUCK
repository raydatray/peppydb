# Build configuration: the build_mode setting and the platforms that use it.

load("@prelude//platforms:defs.bzl", "host_configuration")
load(":platforms.bzl", "peppy_execution_platform", "peppy_execution_platforms")

# Debug, release, or Miri. The Rust toolchain selects its optimization flags
# and, for Miri, a nightly compiler on this.
constraint_setting(name = "build_mode")

constraint_value(
    name = "mode-debug",
    constraint_setting = ":build_mode",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "mode-release",
    constraint_setting = ":build_mode",
    visibility = ["PUBLIC"],
)

# Release flags plus debug line tables and frame pointers, for profiles with
# readable stacks (plan 0024). Reference measurements use mode-release.
constraint_value(
    name = "mode-profile",
    constraint_setting = ":build_mode",
    visibility = ["PUBLIC"],
)

# Debug flags with the pinned nightly toolchain and its Miri driver. Every
# rust_test gets a `[miri]` sub-target in this mode.
constraint_value(
    name = "mode-miri",
    constraint_setting = ":build_mode",
    visibility = ["PUBLIC"],
)

# The host platform with release flags: `buck2 ... @build/mode/release`.
# Release outputs get their own configuration, so they are cached separately
# from debug outputs.
platform(
    name = "release",
    constraint_values = [":mode-release"],
    deps = ["prelude//platforms:default"],
    visibility = ["PUBLIC"],
)

# The host platform with profile flags: `buck2 ... @build/mode/profile`.
platform(
    name = "profile",
    constraint_values = [":mode-profile"],
    deps = ["prelude//platforms:default"],
    visibility = ["PUBLIC"],
)

# The host platform with the nightly toolchain and Miri:
# `buck2 test @build/mode/miri '<test>[miri]'`.
platform(
    name = "miri",
    constraint_values = [":mode-miri"],
    deps = ["prelude//platforms:default"],
    visibility = ["PUBLIC"],
)

# Linux on x86_64, as on GitHub's runners. Used to check from other hosts that
# the configured graph (including platform-specific Go dependencies) resolves.
platform(
    name = "linux-x86_64",
    constraint_values = [
        "config//cpu/constraints:x86_64",
        "config//os/constraints:linux",
    ],
    deps = ["prelude//platforms:default"],
    visibility = ["PUBLIC"],
)

# Execution platforms (see platforms.bzl). The plain host comes first, so every
# mode except Miri builds its tools exactly as with the prelude's default.
peppy_execution_platform(
    name = "exec-host",
    constraints = [host_configuration.cpu, host_configuration.os],
)

peppy_execution_platform(
    name = "exec-host-miri",
    constraints = [host_configuration.cpu, host_configuration.os, ":mode-miri"],
)

peppy_execution_platforms(
    name = "execution-platforms",
    platforms = [":exec-host", ":exec-host-miri"],
    visibility = ["PUBLIC"],
)

# BuildBuddy hybrid execution platforms (plan 0036), selected via
# `build/config/buildbuddy.bcfg` on Linux (WSL2 and CI). All Linux compilers,
# linkers, and sysroots are hermetic Buck2 inputs (plan 0035), but remote
# actions still run host tools from the image: prelude `http_archive` unpacks
# deferred downloads remotely with `tar -J` (needs `xz`) and `unzip`. The stock
# `ubuntu:24.04` image has neither, so use BuildBuddy's digest-pinned
# `rbe-ubuntu24-04` image (multi-arch index; Ubuntu 24.04, glibc 2.39), which
# adds `xz`, `unzip`, `bzip2`, and `python3`.
_BUILDBUDDY_PROPS = {
    "OSFamily": "Linux",
    "Arch": "arm64" if host_info().arch.is_aarch64 else "amd64",
    "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:be9853fc45092d2cf2bda3abed30d22182881659a50bf35c7125161d7cfc8a75",
}

peppy_execution_platform(
    name = "exec-host-buildbuddy",
    constraints = [host_configuration.cpu, host_configuration.os],
    remote = True,
    remote_execution_properties = _BUILDBUDDY_PROPS,
)

peppy_execution_platform(
    name = "exec-host-miri-buildbuddy",
    constraints = [host_configuration.cpu, host_configuration.os, ":mode-miri"],
    remote = True,
    remote_execution_properties = _BUILDBUDDY_PROPS,
)

peppy_execution_platforms(
    name = "execution-platforms-buildbuddy",
    platforms = [":exec-host-buildbuddy", ":exec-host-miri-buildbuddy"],
    visibility = ["PUBLIC"],
)
