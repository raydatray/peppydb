load("//build:defs.bzl", "peppy_rust_library")

# Raft for the server component (plan 0028): openraft behind peppydb's own
# types. Internal to the server component; `server` is its only dependent.
peppy_rust_library(
    name = "server-raft",
    deps = [
        "//third-party/rust:openraft",
        "//third-party/rust:openraft-rt-tokio",
        "//third-party/rust:thiserror",
    ],
    test_deps = [
        "//third-party/rust:openraft-rt-sim",
    ],
    visibility = ["//lib/server:"],
    # The simulator's models (`server_raft::sim`), for the tests of other
    # server crates (plan 0028). Production targets never enable it.
    feature_variants = {
        "sim": {
            "deps": [
                "//third-party/rust:openraft",
                "//third-party/rust:openraft-rt-tokio",
                "//third-party/rust:thiserror",
            ],
            "visibility": ["//lib/server:server-unittest"],
        },
    },
)
