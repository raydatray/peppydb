#!/usr/bin/env python3
"""Pin the Go toolchain downloaded by Buck2.

Buck2 downloads this Go distribution for all Go builds and tools (see
build/toolchains/BUCK). This script writes the pins to
build/toolchains/go.bzl from go.dev's release feed and keeps go.mod in
sync.

    tools/update-go           pin the version currently in go.mod
    tools/update-go 1.27.0    update go.mod and pin 1.27.0

After updating, run the verification checks from AGENTS.md before committing.
"""

import json
import pathlib
import re
import sys
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
GO_MOD = ROOT / "go.mod"
OUT = ROOT / "build" / "toolchains" / "go.bzl"
FEED = "https://go.dev/dl/?mode=json&include=all"

HOSTS = {
    "darwin-arm64": ("darwin", "arm64"),
    "linux-amd64": ("linux", "amd64"),
    "linux-arm64": ("linux", "arm64"),
}


def current_version():
    match = re.search(r"^go\s+([0-9.]+)$", GO_MOD.read_text(), re.MULTILINE)
    if not match:
        sys.exit(f"update-go: no go version directive in {GO_MOD}")
    return match.group(1)


def fetch_releases():
    with urllib.request.urlopen(FEED) as response:
        return json.loads(response.read().decode())


def pins(version, releases):
    tag = f"go{version}"
    entry = next((r for r in releases if r.get("version") == tag), None)
    if entry is None:
        sys.exit(f"update-go: release {tag} not found at {FEED}")
    by_filename = {f["filename"]: f for f in entry.get("files", [])}
    result = {}
    for host, (goos, goarch) in HOSTS.items():
        filename = f"go{version}.{host}.tar.gz"
        info = by_filename.get(filename)
        if info is None or info.get("kind") != "archive":
            sys.exit(f"update-go: {tag} lacks archive {filename}")
        result[host] = [goos, goarch, info["sha256"]]
    return result


def render(version, releases):
    lines = [
        '"""@generated by tools/update-go. Do not edit."""',
        "",
        f'GO_VERSION = "{version}"',
        "",
        "# host: (GOOS, GOARCH, sha256)",
        "GO_RELEASES = {",
    ]
    for host in sorted(releases):
        goos, goarch, sha256 = releases[host]
        lines.append(f'    "{host}": ("{goos}", "{goarch}", "{sha256}"),')
    lines.append("}")
    lines.append("")
    return "\n".join(lines)


def update_go_mod(version):
    text = GO_MOD.read_text()
    updated, count = re.subn(
        r"^(go\s+)[0-9.]+$",
        rf"\g<1>{version}",
        text,
        count=1,
        flags=re.MULTILINE,
    )
    if count != 1:
        sys.exit(f"update-go: could not update go directive in {GO_MOD}")
    if updated != text:
        GO_MOD.write_text(updated)


def main(args):
    if len(args) > 1 or (args and args[0].startswith("-")):
        sys.exit(__doc__)
    version = args[0] if args else current_version()
    found = pins(version, fetch_releases())
    if args:
        update_go_mod(version)
    OUT.write_text(render(version, found))
    print(f"update-go: pinned {version} in {OUT.relative_to(ROOT)}")


if __name__ == "__main__":
    main(sys.argv[1:])
