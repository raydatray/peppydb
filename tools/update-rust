#!/usr/bin/env python3
"""Pin the stable Rust toolchain downloaded by Buck2.

Buck2 downloads this toolchain for normal builds (see build/toolchains/rust.bzl).
This script writes the pins to build/toolchains/rust_stable.bzl: the version,
and for every supported host the URL and sha256 of each component archive,
taken from the release's channel manifest.

    tools/update-rust           pin the version currently in rust-toolchain.toml
    tools/update-rust 1.98.1    update rust-toolchain.toml and pin 1.98.1

After updating, run `tools/autocargo` and the verification checks from AGENTS.md
before committing.
"""

import json
import pathlib
import re
import sys
import tomllib
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
TOOLCHAIN_TOML = ROOT / "rust-toolchain.toml"
OUT = ROOT / "build" / "toolchains" / "rust_stable.bzl"
DIST = "https://static.rust-lang.org/dist"

# Host names follow GO_RELEASES in build/toolchains/go.bzl.
HOSTS = {
    "darwin-arm64": "aarch64-apple-darwin",
    "linux-amd64": "x86_64-unknown-linux-gnu",
    "linux-arm64": "aarch64-unknown-linux-gnu",
}

# Component: (manifest package, directory inside the archive).
# `{v}` is the Rust version and `{t}` is the Rust target triple.
COMPONENTS = {
    "rustc": ("rustc", "rustc-{v}-{t}/rustc"),
    "rust-std": ("rust-std", "rust-std-{v}-{t}/rust-std-{t}"),
    "cargo": ("cargo", "cargo-{v}-{t}/cargo"),
    "clippy": ("clippy-preview", "clippy-{v}-{t}/clippy-preview"),
    "rustfmt": ("rustfmt-preview", "rustfmt-{v}-{t}/rustfmt-preview"),
}
SOURCE = ("rust-src", "rust-src-{v}/rust-src")


def current_version():
    data = tomllib.loads(TOOLCHAIN_TOML.read_text())
    return data["toolchain"]["channel"]


def manifest(version):
    url = f"{DIST}/channel-rust-{version}.toml"
    with urllib.request.urlopen(url) as response:
        return tomllib.loads(response.read().decode())


def archive(pkg, target, prefix):
    entry = pkg["target"].get(target)
    if not entry or not entry.get("available"):
        return None
    return {"url": entry["xz_url"], "sha256": entry["xz_hash"], "strip_prefix": prefix}


def pins(version, m):
    hosts = {}
    for host, triple in HOSTS.items():
        components = {}
        for name, (pkg, prefix) in COMPONENTS.items():
            if pkg not in m["pkg"]:
                sys.exit(f"update-rust: {version} manifest lacks package {pkg}")
            a = archive(m["pkg"][pkg], triple, prefix.format(v=version, t=triple))
            if a is None:
                sys.exit(f"update-rust: {version} lacks {pkg} for {triple}")
            components[name] = a
        hosts[host] = components
    pkg, prefix = SOURCE
    source = archive(m["pkg"][pkg], "*", prefix.format(v=version))
    if source is None:
        sys.exit(f"update-rust: {version} lacks {pkg}")
    return hosts, source


def render(version, hosts, source):
    lines = [
        '"""@generated by tools/update-rust. Do not edit."""',
        "",
        f'RUST_VERSION = "{version}"',
        "",
        "# host: component: archive",
        "RUST_COMPONENTS = " + json.dumps(hosts, indent=4, sort_keys=True),
        "",
        "RUST_SRC = " + json.dumps(source, indent=4, sort_keys=True),
        "",
    ]
    return "\n".join(lines)


def update_toolchain_toml(version):
    text = TOOLCHAIN_TOML.read_text()
    updated, count = re.subn(
        r'^(channel\s*=\s*)"[^"]*"$',
        rf'\1"{version}"',
        text,
        count=1,
        flags=re.MULTILINE,
    )
    if count != 1:
        sys.exit(f"update-rust: could not update channel in {TOOLCHAIN_TOML}")
    if updated != text:
        TOOLCHAIN_TOML.write_text(updated)


def main(args):
    if len(args) > 1 or (args and args[0].startswith("-")):
        sys.exit(__doc__)
    version = args[0] if args else current_version()
    m = manifest(version)
    hosts, source = pins(version, m)
    if args:
        update_toolchain_toml(version)
    OUT.write_text(render(version, hosts, source))
    print(f"update-rust: pinned {version} in {OUT.relative_to(ROOT)}")


if __name__ == "__main__":
    main(sys.argv[1:])
