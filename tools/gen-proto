#!/bin/sh
# Lint proto/, check it for breaking changes, and generate its Rust and Go
# code (plan 0026; see docs/design/server.md).
#
#   tools/gen-proto           write the generated code
#   tools/gen-proto --check   fail if the generated code is out of date, or
#                             if lint or the breaking-change check fails
#
# Every tool is pinned. buf and the Go plugins come from the `tool`
# directives in go.mod and run with the Go distribution that Buck2
# downloads (GO_VERSION). Buck2 cannot build buf itself: buf refuses to run
# without Go module build information, which only the go command embeds.
# Rust code comes from //tools/protogen (tonic-prost-build, pinned in
# Cargo.lock). No registry dependency and no remote plugin is used.
#
# The breaking-change baseline is proto/ at the parent revision (`.^`), or
# at PROTO_BASE if it is set. If the baseline has no proto/, the check is
# skipped.
set -eu
cd "$(dirname "$0")/.."
root=$(pwd)

check=false
case "${1:-}" in
    "") ;;
    --check) check=true ;;
    *) sed -n '2,8p' "$0" >&2; exit 2 ;;
esac

rust_out=crates/server-proto/src/generated

goroot=$(tools/buck2 build toolchains//:go-root --show-full-simple-output 2>/dev/null)
go="$goroot/bin/go"
export GOTOOLCHAIN=local GOFLAGS=-mod=mod

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# buf and the plugins, built once into a scratch directory.
"$go" build -o "$tmp/bin/" \
    github.com/bufbuild/buf/cmd/buf \
    google.golang.org/protobuf/cmd/protoc-gen-go \
    google.golang.org/grpc/cmd/protoc-gen-go-grpc
buf="$tmp/bin/buf"
export PATH="$tmp/bin:$PATH"

"$buf" lint

base="${PROTO_BASE:-.^}"
mkdir -p "$tmp/base"
files=$(sl files -r "$base" 'glob:proto/**' 2>/dev/null || true)
if [ -n "$files" ]; then
    for f in $files buf.yaml; do
        mkdir -p "$tmp/base/$(dirname "$f")"
        sl cat -r "$base" "$f" > "$tmp/base/$f"
    done
    "$buf" breaking --against "$tmp/base"
else
    echo "gen-proto: no proto/ at $base; skipping the breaking-change check"
fi

# Generate into a scratch tree, then compare or copy.
mkdir -p "$tmp/out/go" "$tmp/out/rust"
"$buf" build -o "$tmp/descriptors.binpb"
tools/buck2 run //tools/protogen:protogen -- "$tmp/descriptors.binpb" "$tmp/out/rust" 2>/dev/null
"$buf" generate --template buf.gen.yaml -o "$tmp/out"

status=0
# compare <generated dir> <tree dir> <glob>: the files matching <glob> in
# <tree dir> must equal the generated ones. Other files (BUCK, lib.rs) are
# left alone.
compare() {
    for f in "$2"/$3; do
        [ -e "$f" ] || continue
        if [ ! -e "$1/$(basename "$f")" ]; then
            if $check; then
                echo "gen-proto: $f is stale; run tools/gen-proto" >&2
                status=1
            else
                rm "$f"
            fi
        fi
    done
    for f in "$1"/$3; do
        dest="$2/$(basename "$f")"
        if $check; then
            if ! cmp -s "$f" "$dest"; then
                echo "gen-proto: $dest is out of date; run tools/gen-proto" >&2
                diff "$f" "$dest" >&2 || true
                status=1
            fi
        else
            mkdir -p "$2"
            cp "$f" "$dest"
        fi
    done
}
compare "$tmp/out/rust" "$rust_out" '*.rs'
compare "$tmp/out/go/kvpb" go/kvpb '*.pb.go'
exit "$status"
