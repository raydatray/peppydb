#!/usr/bin/env python3
"""Generate third-party/go/BUCK from go/go.mod, without vendoring.

    tools/gobuckify-remote           write third-party/go/BUCK
    tools/gobuckify-remote --check   fail if the committed file differs

This is the Go counterpart of reindeer. go/go.mod is the only list of Go
dependency versions. For the packages that first-party code imports, on
each supported platform, the generated file has:

  - one http_archive per module: the proxy.golang.org zip, pinned by the
    sha256 of the file that `go mod download` verified against go.sum;
  - one go_library (or go_binary, for `main` packages) per package, which
    takes its sources from the archive through sub_targets. Imports that
    exist on only some platforms are added with select().

Target names are import paths: //third-party/go:golang.org/x/sync/errgroup.
cgo is disabled; packages that need it are not supported.
"""

import hashlib
import json
import os
import pathlib
import subprocess
import sys
import zipfile
from collections import defaultdict

ROOT = pathlib.Path(__file__).resolve().parent.parent
MODULE_DIR = ROOT / "go"
OUT = ROOT / "third-party" / "go" / "BUCK"

# (GOOS, GOARCH) -> (Buck2 OS setting, Buck2 CPU setting)
PLATFORMS = {
    ("darwin", "arm64"): ("config//os:macos", "config//cpu:arm64"),
    ("linux", "amd64"): ("config//os:linux", "config//cpu:x86_64"),
    ("linux", "arm64"): ("config//os:linux", "config//cpu:arm64"),
}
SOURCE_SUFFIXES = (".go", ".s", ".S", ".h")
HEADER = """\
# @generated by tools/gobuckify-remote from go/go.mod. Do not edit.
# Run tools/gobuckify-remote after changing go/go.mod.
"""


def go_json(args, env=None):
    """Run a go command that prints a stream of JSON objects."""
    out = subprocess.run(["go", *args], cwd=MODULE_DIR, env=env,
                         check=True, capture_output=True, text=True).stdout
    decoder, pos, objects = json.JSONDecoder(), 0, []
    while True:
        while pos < len(out) and out[pos].isspace():
            pos += 1
        if pos == len(out):
            return objects
        obj, pos = decoder.raw_decode(out, pos)
        objects.append(obj)


def escape(path):
    """Module path escaping used by the module proxy and in module zips."""
    return "".join("!" + c.lower() if c.isupper() else c for c in path)


def collect():
    """Third-party packages, and their imports and embeds per platform."""
    root_module = go_json(["list", "-m", "-json"])[0]["Path"]
    packages = {}
    imports = defaultdict(dict)
    embeds = defaultdict(set)
    for goos, goarch in PLATFORMS:
        env = dict(os.environ, GOOS=goos, GOARCH=goarch, CGO_ENABLED="0", GOFLAGS="-mod=mod")
        listed = go_json(["list", "-e", "-deps",
                          "-json=Name,ImportPath,Dir,Imports,EmbedFiles,Standard,Module,Error",
                          "./..."], env)
        for p in listed:
            module = p.get("Module")
            if p.get("Standard") or not module or module["Path"] == root_module:
                continue
            if p.get("Error"):
                sys.exit(f"gobuckify-remote: {p['ImportPath']}: {p['Error']['Err']}")
            path = p["ImportPath"]
            packages[path] = {
                "module": (module["Path"], module["Version"]),
                "dir": os.path.relpath(p["Dir"], module["Dir"]),
                "main": p["Name"] == "main",
            }
            imports[path][(goos, goarch)] = set(p.get("Imports") or [])
            embeds[path].update(p.get("EmbedFiles") or [])
    return packages, imports, embeds


def archives(modules):
    """For each module: sha256 of its zip, the zip's prefix, files per directory."""
    result = {}
    for path, version in modules:
        info = go_json(["mod", "download", "-json", f"{path}@{version}"])[0]
        digest = hashlib.sha256(pathlib.Path(info["Zip"]).read_bytes()).hexdigest()
        prefix = f"{escape(path)}@{version}"
        files = defaultdict(list)
        with zipfile.ZipFile(info["Zip"]) as z:
            for name in z.namelist():
                rel = name[len(prefix) + 1:]
                files[os.path.dirname(rel) or "."].append(rel)
        result[(path, version)] = {"sha256": digest, "prefix": prefix, "files": files}
    return result


def select_expr(per_platform):
    """`select()` over OS, then CPU, for platform-only dependencies."""
    by_os = defaultdict(dict)
    for (goos, goarch), deps in sorted(per_platform.items()):
        if deps:
            os_setting, cpu_setting = PLATFORMS[(goos, goarch)]
            by_os[os_setting][cpu_setting] = deps
    if not by_os:
        return ""
    lines = [" + select({"]
    for os_setting, cpus in sorted(by_os.items()):
        lines.append(f'        "{os_setting}": select({{')
        for cpu_setting, deps in sorted(cpus.items()):
            lines.append(f'            "{cpu_setting}": {json.dumps(deps)},')
        lines.append('            "DEFAULT": [],')
        lines.append("        }),")
    lines.append('        "DEFAULT": [],')
    lines.append("    })")
    return "\n".join(lines)


def render():
    packages, imports, embeds = collect()
    third_party = set(packages)
    modules = sorted({p["module"] for p in packages.values()})
    zips = archives(modules)

    out = [HEADER]
    for module in modules:
        path, version = module
        z = zips[module]
        sub_targets = {}
        for pkg, info in packages.items():
            if info["module"] != module:
                continue
            d = info["dir"]
            sub_targets[d] = sorted(f for f in z["files"].get(d, [])
                                    if f.endswith(SOURCE_SUFFIXES) and not f.endswith("_test.go"))
            if embeds[pkg]:
                sub_targets[d + "__embed"] = sorted(
                    e if d == "." else f"{d}/{e}" for e in embeds[pkg])
        out.append("http_archive(")
        out.append(f'    name = "{path}__srcs",')
        out.append(f'    urls = ["https://proxy.golang.org/{escape(path)}/@v/{version}.zip"],')
        out.append(f'    sha256 = "{z["sha256"]}",')
        out.append(f'    strip_prefix = "{z["prefix"]}",')
        out.append("    sub_targets = {")
        for key in sorted(sub_targets):
            out.append(f'        "{key}": {json.dumps(sub_targets[key])},')
        out.append("    },")
        out.append(")")
        out.append("")

    for pkg in sorted(packages):
        info = packages[pkg]
        per_platform = {plat: sorted(":" + d for d in deps & third_party)
                        for plat, deps in imports[pkg].items()}
        common = sorted(set.intersection(*(set(v) for v in per_platform.values())))
        only = {plat: [d for d in deps if d not in common] for plat, deps in per_platform.items()}
        module_path = info["module"][0]
        out.append("go_binary(" if info["main"] else "go_library(")
        out.append(f'    name = "{pkg}",')
        out.append(f'    package_name = "{pkg}",')
        out.append(f'    srcs = [":{module_path}__srcs[{info["dir"]}]"],')
        if embeds[pkg]:
            out.append(f'    embed_srcs = [":{module_path}__srcs[{info["dir"]}__embed]"],')
        deps = json.dumps(common) + select_expr(only)
        if deps != "[]":
            out.append(f"    deps = {deps},")
        out.append('    visibility = ["PUBLIC"],')
        out.append(")")
        out.append("")
    return "\n".join(out), len(modules), len(packages)


def main(check):
    text, n_modules, n_packages = render()
    if check:
        if not OUT.exists() or OUT.read_text() != text:
            sys.exit("gobuckify-remote: third-party/go/BUCK is out of date; "
                     "run tools/gobuckify-remote and commit the result")
        print(f"gobuckify-remote: up to date ({n_modules} modules, {n_packages} packages)")
        return
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(text)
    print(f"gobuckify-remote: wrote {n_modules} modules, {n_packages} packages")


if __name__ == "__main__":
    args = sys.argv[1:]
    if args not in ([], ["--check"]):
        sys.exit(__doc__)
    main(args == ["--check"])
