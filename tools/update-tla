#!/usr/bin/env python3
"""Pin the TLA+ toolchain (Temurin JRE + tla2tools.jar) downloaded by Buck2.

Buck2 downloads these archives to run `peppy_tla_test` targets hermetically
(see build/toolchains/BUCK). This script writes the pins to
build/toolchains/tla.bzl from Adoptium's Temurin 21 LTS release feed and the
tlaplus/tlaplus GitHub release for tla2tools.jar.

    tools/update-tla           pin the current tla2tools version and latest Temurin 21 JRE
    tools/update-tla 1.7.4     pin tla2tools.jar v1.7.4 and latest Temurin 21 JRE

After updating, run the verification checks from AGENTS.md before committing.
"""

import hashlib
import json
import pathlib
import re
import sys
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "build" / "toolchains" / "tla.bzl"
DEFAULT_TLA_VERSION = "1.7.4"
JRE_FEATURE_VERSION = 21
ADOPTIUM_FEED = (
    f"https://api.adoptium.net/v3/assets/latest/{JRE_FEATURE_VERSION}/hotspot"
    "?image_type=jre&vendor=eclipse"
)
TLA_URL_TEMPLATE = (
    "https://github.com/tlaplus/tlaplus/releases/download/v{version}/tla2tools.jar"
)
USER_AGENT = "peppydb-update-tla"

# host: (adoptium_os, adoptium_arch, strip_suffix)
HOSTS = {
    "darwin-arm64": ("mac", "aarch64", "/Contents/Home"),
    "linux-amd64": ("linux", "x64", ""),
    "linux-arm64": ("linux", "aarch64", ""),
}


def current_tla_version():
    if not OUT.exists():
        return DEFAULT_TLA_VERSION
    match = re.search(r'^TLA_VERSION\s*=\s*"([^"]+)"$', OUT.read_text(), re.MULTILINE)
    return match.group(1) if match else DEFAULT_TLA_VERSION


def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req) as response:
        return json.loads(response.read().decode())


def sha256_url(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    digest = hashlib.sha256()
    with urllib.request.urlopen(req) as response:
        while chunk := response.read(65536):
            digest.update(chunk)
    return digest.hexdigest()


def jre_pins(assets):
    by_target = {}
    for item in assets:
        binary = item.get("binary", {})
        pkg = binary.get("package", {})
        if not pkg.get("name", "").endswith(".tar.gz"):
            continue
        key = (binary.get("os"), binary.get("architecture"))
        by_target[key] = (item["release_name"], pkg["link"], pkg["checksum"])

    release_names = set()
    result = {}
    for host, (os_name, arch, suffix) in HOSTS.items():
        info = by_target.get((os_name, arch))
        if info is None:
            sys.exit(f"update-tla: Temurin {JRE_FEATURE_VERSION} JRE missing for {host}")
        release_name, link, sha256 = info
        release_names.add(release_name)
        strip_prefix = f"{release_name}-jre{suffix}"
        result[host] = (link, sha256, strip_prefix)

    if len(release_names) != 1:
        sys.exit(f"update-tla: mismatched JRE releases across hosts: {sorted(release_names)}")
    return next(iter(release_names)), result


def render(tla_version, tla_url, tla_sha256, jre_version, jres):
    lines = [
        '"""@generated by tools/update-tla. Do not edit."""',
        "",
        f'TLA_VERSION = "{tla_version}"',
        "TLA_JAR = {",
        f'    "url": "{tla_url}",',
        f'    "sha256": "{tla_sha256}",',
        "}",
        "",
        f'JRE_VERSION = "{jre_version}"',
        "",
        "# host: (url, sha256, strip_prefix)",
        "JRE_RELEASES = {",
    ]
    for host in sorted(jres):
        url, sha256, strip_prefix = jres[host]
        lines.append(f'    "{host}": (')
        lines.append(f'        "{url}",')
        lines.append(f'        "{sha256}",')
        lines.append(f'        "{strip_prefix}",')
        lines.append("    ),")
    lines.append("}")
    lines.append("")
    return "\n".join(lines)


def main(args):
    if len(args) > 1 or (args and args[0].startswith("-")):
        sys.exit(__doc__)
    tla_version = args[0] if args else current_tla_version()
    tla_url = TLA_URL_TEMPLATE.format(version=tla_version)
    tla_sha256 = sha256_url(tla_url)
    jre_version, jres = jre_pins(fetch_json(ADOPTIUM_FEED))
    OUT.write_text(render(tla_version, tla_url, tla_sha256, jre_version, jres))
    print(
        f"update-tla: pinned tla2tools {tla_version} and Temurin JRE {jre_version} "
        f"in {OUT.relative_to(ROOT)}"
    )


if __name__ == "__main__":
    main(sys.argv[1:])
