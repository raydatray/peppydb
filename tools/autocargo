#!/usr/bin/env python3
"""Generate the Cargo manifests from the Buck2 graph.

Buck2 is the source of truth for first-party Rust code. This script writes a
Cargo.toml for every first-party crate, the workspace Cargo.toml, and the root
Cargo.lock, so that `cargo` keeps working for Cargo-based tools.

    tools/autocargo           write the files
    tools/autocargo --check   fail if any committed file differs

Mapping:
  - A `rust_library` or `rust_binary` under //bin, //lib, or //proto is a package.
    Its target name is the package name.
  - First-party dependencies (`//lib/<x>:<x>` and the like) become path
    dependencies.
  - `//third-party/rust:<x>` dependencies become `<x>.workspace = true`. The
    versions and features come from third-party/rust/Cargo.toml.
  - Dependencies that only the `<name>-unittest` target has become
    dev-dependencies.
  - A feature variant (`peppy_rust_library`'s `feature_variants`) is a
    `rust_library` with `features`. It becomes a `[features]` entry of its
    package, which enables the same feature of each variant it depends on,
    and a dependency on it becomes a path dependency with that feature.
  - The root Cargo.lock is derived from third-party/rust/Cargo.lock with
    `cargo update --workspace`, which changes only workspace entries. Cargo
    and Buck2 therefore build the same third-party versions.

Buck2-only behavior (visibility, the release platform, denied warnings) has
no Cargo equivalent. The Buck2 checks cover it.
"""

import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
THIRD_PARTY = ROOT / "third-party" / "rust"
MARKER = "@generated by tools/autocargo"
# Top-level directories that hold first-party Rust packages.
FIRST_PARTY = ("bin/", "lib/", "proto/")
TARGET = re.compile(r"^root//(?P<package>[^:]+):(?P<name>\S+)")


def query():
    """Rust targets under //bin, //lib, and //proto with their dependencies."""
    out = subprocess.run(
        [
            str(ROOT / "tools" / "buck2"), "cquery",
            'kind("rust_(library|binary|test)", //bin/... + //lib/... + //proto/...)',
            "--output-attribute", "buck.type|crate|crate_root|deps|features|name",
            "--json",
        ],
        cwd=ROOT, check=True, capture_output=True, text=True,
    ).stdout
    targets = {}
    for label, attrs in json.loads(out).items():
        m = TARGET.match(label)
        deps = []
        for dep in attrs["deps"]:
            d = TARGET.match(dep)
            if not d:
                sys.exit(f"autocargo: unsupported dependency {dep} of {label}")
            deps.append((d["package"], d["name"]))
        targets[(m["package"], m["name"])] = {
            "type": attrs["buck.type"],
            "crate": attrs["crate"],
            "crate_root": attrs["crate_root"],
            "deps": deps,
            "features": attrs.get("features") or [],
        }
    return targets


def dependency_line(package, dep, third_party, targets):
    """The Cargo.toml line for one Buck2 dependency of `package`."""
    dep_package, dep_name = dep
    if dep_package == "third-party/rust":
        if dep_name not in third_party:
            sys.exit(f"autocargo: {dep_name} is not in third-party/rust/Cargo.toml")
        return dep_name, f"{dep_name}.workspace = true"
    if dep_package.startswith(FIRST_PARTY):
        rel = os.path.relpath(ROOT / dep_package, ROOT / package)
        features = targets[dep]["features"]
        name = base_name(dep, targets)
        if features:
            return name, f'{name} = {{ path = "{rel}", features = {toml_value(features)} }}'
        return name, f'{name} = {{ path = "{rel}" }}'
    sys.exit(f"autocargo: unsupported dependency //{dep_package}:{dep_name} of {package}")


def base_name(dep, targets):
    """The package name of a library, or of the library a variant varies."""
    package, name = dep
    for feature in targets[dep]["features"]:
        suffix = f"-{feature}"
        if name.endswith(suffix):
            return name[: -len(suffix)]
    return name


def toml_value(value):
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{k} = {toml_value(v)}" for k, v in value.items()) + " }"
    raise TypeError(value)


def render(targets):
    """Map of repository-relative path to file contents."""
    third_party = tomllib.loads((THIRD_PARTY / "Cargo.toml").read_text())["dependencies"]
    channel = tomllib.loads((ROOT / "rust-toolchain.toml").read_text())["toolchain"]["channel"]

    packages = {}
    for (package, name), t in sorted(targets.items()):
        if t["type"] == "rust_test" or t["features"]:
            continue
        packages.setdefault(package, []).append((name, t))

    files = {}
    for package, members in sorted(packages.items()):
        libs = [(n, t) for n, t in members if t["type"] == "rust_library"]
        bins = [(n, t) for n, t in members if t["type"] == "rust_binary"]
        if len(libs) > 1 or (not libs and len(bins) != 1):
            sys.exit(f"autocargo: //{package} must define one library or one binary")
        name, main = libs[0] if libs else bins[0]

        deps = dict(dependency_line(package, d, third_party, targets) for d in main["deps"])
        test = targets.get((package, name + "-unittest"))
        dev = {}
        if test:
            for d in test["deps"]:
                key, line = dependency_line(package, d, third_party, targets)
                if key not in deps or line != deps[key]:
                    dev[key] = line
        features = {}
        for (vpackage, vname), v in sorted(targets.items()):
            if vpackage != package or v["type"] != "rust_library" or not v["features"]:
                continue
            for feature in v["features"]:
                enables = sorted(
                    f"{base_name(d, targets)}/{f}"
                    for d in v["deps"]
                    if d[0].startswith(FIRST_PARTY)
                    for f in targets[d]["features"]
                )
                features[feature] = enables

        lines = [
            f"# {MARKER} from {package}/BUCK. Do not edit.",
            "[package]",
            f'name = "{name}"',
            "version.workspace = true",
            "edition.workspace = true",
            "rust-version.workspace = true",
            "publish = false",
        ]
        if libs:
            lib = ["[lib]"]
            if main["crate"] != name.replace("-", "_"):
                lib.append(f'name = "{main["crate"]}"')
            if main["crate_root"] != "src/lib.rs":
                lib.append(f'path = "{main["crate_root"]}"')
            if len(lib) > 1:
                lines += [""] + lib
        else:
            lines += ["", "[[bin]]", f'name = "{name}"', f'path = "{main["crate_root"]}"']
        if deps:
            lines += ["", "[dependencies]"] + [deps[k] for k in sorted(deps)]
        if dev:
            lines += ["", "[dev-dependencies]"] + [dev[k] for k in sorted(dev)]
        if features:
            lines += ["", "[features]"] + [
                f"{k} = {toml_value(v)}" for k, v in sorted(features.items())
            ]
        lines += ["", "[lints]", "workspace = true", ""]
        files[f"{package}/Cargo.toml"] = "\n".join(lines)

    members = ", ".join(json.dumps(p) for p in sorted(packages))
    workspace = [
        f"# {MARKER} from the BUCK files. Do not edit.",
        "[workspace]",
        f"members = [{members}]",
        "# Buck2 input only; see third-party/rust/Cargo.toml.",
        'exclude = ["third-party/rust"]',
        'resolver = "3"',
        "",
        "[workspace.package]",
        'version = "0.1.0"',
        'edition = "2024"',
        f'rust-version = "{channel}"',
        "",
        "[workspace.dependencies]",
    ]
    workspace += [f"{k} = {toml_value(v)}" for k, v in sorted(third_party.items())]
    workspace += ["", "[workspace.lints.rust]", 'unsafe_code = "deny"', ""]
    files["Cargo.toml"] = "\n".join(workspace)
    files["Cargo.lock"] = derive_lock(files, targets)
    return files


def derive_lock(files, targets):
    """Resolve the workspace lock from the third-party lock, in a scratch copy."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp = pathlib.Path(tmp)
        for path, text in files.items():
            (tmp / path).parent.mkdir(parents=True, exist_ok=True)
            (tmp / path).write_text(text)
        # Cargo needs each target's root file to exist; contents do not matter.
        for (package, _), t in targets.items():
            root = tmp / package / t["crate_root"]
            root.parent.mkdir(parents=True, exist_ok=True)
            root.touch()
        shutil.copy(ROOT / "rust-toolchain.toml", tmp)
        shutil.copy(THIRD_PARTY / "Cargo.lock", tmp / "Cargo.lock")
        subprocess.run(
            ["cargo", "update", "--workspace", "--quiet"],
            cwd=tmp, check=True,
        )
        return (tmp / "Cargo.lock").read_text()


def stale(files):
    """Generated Cargo.toml files that no longer correspond to a package."""
    found = []
    for top in (p.rstrip("/") for p in FIRST_PARTY):
        for path in (ROOT / top).glob("**/Cargo.toml"):
            rel = path.relative_to(ROOT).as_posix()
            if rel not in files and MARKER in path.read_text():
                found.append(rel)
    return sorted(found)


def main(check):
    files = render(query())
    old = stale(files)
    if check:
        differ = [p for p, text in files.items()
                  if not (ROOT / p).exists() or (ROOT / p).read_text() != text]
        if differ or old:
            for p in differ:
                print(f"autocargo: {p} is out of date", file=sys.stderr)
            for p in old:
                print(f"autocargo: {p} is stale", file=sys.stderr)
            sys.exit("autocargo: run tools/autocargo and commit the result")
        print(f"autocargo: {len(files)} files up to date")
        return
    for p, text in files.items():
        (ROOT / p).write_text(text)
    for p in old:
        (ROOT / p).unlink()
    print(f"autocargo: wrote {len(files)} files" + (f", removed {len(old)}" if old else ""))


if __name__ == "__main__":
    args = sys.argv[1:]
    if args not in ([], ["--check"]):
        sys.exit(__doc__)
    main(args == ["--check"])
