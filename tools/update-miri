#!/usr/bin/env python3
"""Pin the nightly Rust toolchain that Miri runs on.

Buck2 downloads this nightly for `@build/mode/miri` (see
build/toolchains/rust.bzl). This script writes the pins to
build/toolchains/miri_nightly.bzl: the date, and for every supported host the
URL and sha256 of each component archive, taken from the nightly's channel
manifest.

    tools/update-miri              pin the newest nightly that has Miri for every host
    tools/update-miri 2026-11-01   pin a specific date

After updating, run the Miri check from AGENTS.md before committing.
"""

import datetime
import json
import pathlib
import sys
import tomllib
import urllib.error
import urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "build" / "toolchains" / "miri_nightly.bzl"
DIST = "https://static.rust-lang.org/dist"

# Host names follow GO_RELEASES in build/toolchains/BUCK.
HOSTS = {
    "darwin-arm64": "aarch64-apple-darwin",
    "linux-amd64": "x86_64-unknown-linux-gnu",
    "linux-arm64": "aarch64-unknown-linux-gnu",
}

# Component: (manifest package, directory inside the archive).
# `{t}` is the Rust target triple.
COMPONENTS = {
    "rustc": ("rustc", "rustc-nightly-{t}/rustc"),
    "rust-std": ("rust-std", "rust-std-nightly-{t}/rust-std-{t}"),
    "cargo": ("cargo", "cargo-nightly-{t}/cargo"),
    "miri": ("miri-preview", "miri-nightly-{t}/miri-preview"),
}
SOURCE = ("rust-src", "rust-src-nightly/rust-src")


def manifest(date):
    url = f"{DIST}/{date}/channel-rust-nightly.toml"
    try:
        with urllib.request.urlopen(url) as response:
            return tomllib.loads(response.read().decode())
    except urllib.error.HTTPError as error:
        if error.code == 404:
            return None
        raise


def archive(pkg, target, prefix):
    entry = pkg["target"].get(target)
    if not entry or not entry.get("available"):
        return None
    return {"url": entry["xz_url"], "sha256": entry["xz_hash"], "strip_prefix": prefix}


def pins(m):
    """The pins for one manifest, or None if a component is missing."""
    hosts = {}
    for host, triple in HOSTS.items():
        components = {}
        for name, (pkg, prefix) in COMPONENTS.items():
            if pkg not in m["pkg"]:
                return None
            a = archive(m["pkg"][pkg], triple, prefix.format(t=triple))
            if a is None:
                return None
            components[name] = a
        hosts[host] = components
    pkg, prefix = SOURCE
    source = archive(m["pkg"][pkg], "*", prefix)
    if source is None:
        return None
    return hosts, source


def render(date, hosts, source):
    lines = [
        '"""@generated by tools/update-miri. Do not edit."""',
        "",
        f'MIRI_NIGHTLY = "{date}"',
        "",
        "# host: component: archive",
        "MIRI_COMPONENTS = " + json.dumps(hosts, indent=4, sort_keys=True),
        "",
        "MIRI_RUST_SRC = " + json.dumps(source, indent=4, sort_keys=True),
        "",
    ]
    return "\n".join(lines)


def main(args):
    if len(args) > 1 or (args and args[0].startswith("-")):
        sys.exit(__doc__)
    if args:
        dates = [args[0]]
    else:
        today = datetime.date.today()
        dates = [(today - datetime.timedelta(days=n)).isoformat() for n in range(14)]
    for date in dates:
        m = manifest(date)
        found = m and pins(m)
        if found:
            OUT.write_text(render(date, *found))
            print(f"update-miri: pinned nightly-{date} in {OUT.relative_to(ROOT)}")
            return
        print(f"update-miri: nightly-{date} lacks a component, skipping", file=sys.stderr)
    sys.exit("update-miri: no suitable nightly found")


if __name__ == "__main__":
    main(sys.argv[1:])
