#!/bin/sh
# CI only: install DotSlash at a pinned version, checked by sha256, and put it
# on PATH for later steps. (The install-dotslash action always installs the
# newest release, so it is not used.) Locally: `brew install dotslash`.
set -eu
VERSION=v0.5.9
case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)  P=ubuntu-22.04.x86_64; SHA=ba6b6908c69db8264efdb8ee32f4906284ea3b77247c611339b5f60160cc5691 ;;
    Linux-aarch64) P=ubuntu-22.04.arm64;  SHA=6e358adfd2125ab3f49967107a60a2683231d4f07f0e136735328fa1f21809b2 ;;
    Darwin-arm64)  P=macos;               SHA=67963df97f5ce512f900a85950add6e883722c3460ee5d752a6e62665fd2f986 ;;
    *) echo "install-dotslash: unsupported platform $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
DIR="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/dotslash-$VERSION"
mkdir -p "$DIR"
ARCHIVE="$DIR/dotslash.tar.gz"
curl -fsSL --retry 5 -o "$ARCHIVE" \
    "https://github.com/facebook/dotslash/releases/download/$VERSION/dotslash-$P.$VERSION.tar.gz"
if command -v sha256sum >/dev/null; then
    echo "$SHA  $ARCHIVE" | sha256sum -c - >/dev/null
else
    echo "$SHA  $ARCHIVE" | shasum -a 256 -c - >/dev/null
fi
tar -xzf "$ARCHIVE" -C "$DIR"
"$DIR/dotslash" --version
if [ -n "${GITHUB_PATH:-}" ]; then
    echo "$DIR" >> "$GITHUB_PATH"
fi
