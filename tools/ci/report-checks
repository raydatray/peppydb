#!/usr/bin/env python3
"""CI only: report one GitHub check run per Buck2 package (plan 0036).

The `buck2-test` job runs every affected package in one `tools/buck2 test`
invocation, so that one runner downloads the toolchains and cached outputs
once. This script then creates one check run per package, named
`buck2-test (//lib/...)`, so that the pull request still shows a result for
each package. It also writes a table to the job summary.

Usage: report-checks CONSOLE_LOG TEST_EXIT_CODE

Environment:
  PACKAGES          JSON list of packages that were tested, e.g. ["//lib/a"].
  HEAD_SHA          commit to attach the check runs to.
  GITHUB_TOKEN      token with `checks: write`.
  GITHUB_REPOSITORY, GITHUB_SERVER_URL, GITHUB_RUN_ID, GITHUB_API_URL,
  GITHUB_STEP_SUMMARY: set by GitHub Actions.

Per-target results come from the `TestResult` events in Buck2's event log
(`tools/buck2 log show`). Targets that failed to build have no test result,
so build failures come from `Failed to build` lines in the console log. A
status other than "pass" counts as a failure. This script never changes the
job's result: the test step's own exit code does that. If GitHub refuses to
create a check run (for example, the read-only token of a fork's pull
request), the script prints a warning and continues.
"""

import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

# buck2_data TestStatus: 1 is PASS. Anything else is reported as a failure.
PASS = 1

BUILD_FAILURE = re.compile(r"(?:Failed to build|Action failed:)[^\n]*?root(//[^:\s'`]+):")


def package_of(label: str) -> str:
    """`root//lib/a:b` or `root//lib/a` -> `//lib/a`."""
    package = label.split(":", 1)[0]
    return package[len("root") :] if package.startswith("root//") else package


def test_results() -> list[dict]:
    log = subprocess.run(
        ["tools/buck2", "log", "show"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    results = []
    for line in log.splitlines():
        if '"TestResult"' not in line:
            continue
        event = json.loads(line)["Event"]["data"]
        result = event.get("Instant", {}).get("data", {}).get("TestResult")
        if result:
            results.append(result)
    return results


def create_check_run(name: str, conclusion: str, title: str, summary: str) -> None:
    body = {
        "name": name,
        "head_sha": os.environ["HEAD_SHA"],
        "status": "completed",
        "conclusion": conclusion,
        "details_url": "{}/{}/actions/runs/{}".format(
            os.environ["GITHUB_SERVER_URL"],
            os.environ["GITHUB_REPOSITORY"],
            os.environ["GITHUB_RUN_ID"],
        ),
        "output": {"title": title, "summary": summary[:60000]},
    }
    request = urllib.request.Request(
        "{}/repos/{}/check-runs".format(os.environ["GITHUB_API_URL"], os.environ["GITHUB_REPOSITORY"]),
        data=json.dumps(body).encode(),
        method="POST",
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": "Bearer " + os.environ["GITHUB_TOKEN"],
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    try:
        urllib.request.urlopen(request).close()
    except urllib.error.HTTPError as error:
        print(f"::warning::could not create check run {name!r}: HTTP {error.code}")


def main() -> None:
    console_log, test_exit = sys.argv[1], int(sys.argv[2])
    packages = json.loads(os.environ["PACKAGES"])

    with open(console_log, encoding="utf-8", errors="replace") as f:
        build_failures = {package_of("root" + m) for m in BUILD_FAILURE.findall(f.read())}

    passed: dict[str, list[str]] = {p: [] for p in packages}
    failed: dict[str, list[str]] = {p: [] for p in packages}
    for result in test_results():
        package = package_of(result["target_label"]["label"]["package"])
        if package not in passed:
            continue
        name = result["name"]
        (passed if result["status"] == PASS else failed)[package].append(name)

    rows = []
    for package in packages:
        if failed[package] or package in build_failures:
            conclusion = "failure"
            lines = [f"- ✗ `{name}`" for name in sorted(failed[package])]
            if package in build_failures:
                lines.append("- ✗ a target in this package failed to build")
            title = "failed"
        elif not passed[package] and test_exit != 0:
            conclusion = "failure"
            lines = ["- no test results; the test run failed (see the job log)"]
            title = "no results"
        else:
            conclusion = "success"
            lines = []
            count = len(passed[package])
            title = f"{count} test target{'' if count == 1 else 's'} passed"
        lines += [f"- ✓ `{name}`" for name in sorted(passed[package])]
        create_check_run(f"buck2-test ({package})", conclusion, title, "\n".join(lines) or "No test targets.")
        rows.append(f"| `{package}` | {'✓' if conclusion == 'success' else '✗'} {title} |")

    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a", encoding="utf-8") as f:
            f.write("| Package | Result |\n| --- | --- |\n" + "\n".join(rows) + "\n")


if __name__ == "__main__":
    main()
