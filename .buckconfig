[cells]
  root = .
  prelude = prelude
  toolchains = build/toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# The prelude ships inside the pinned buck2 binary (tools/buck2).
[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[build]
  # The host, and the host in Miri mode; see build/platforms.bzl.
  execution_platforms = root//build:execution-platforms

[project]
  # Cargo's output directory, and tools/gcp-bench's runs (plan 0024); never
  # part of the Buck2 graph. Without the second, every run's staged binaries
  # reset Buck2's file watcher.
  ignore = target, .peppydb-bench
