[cells]
  root = .
  prelude = prelude
  toolchains = build/toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# The prelude ships inside the pinned buck2 binary (tools/buck2).
[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[buck2]
  # Let local actions that state no preference of their own (Rust library
  # compiles, Go actions, archive unpacking) upload their results when a
  # remote cache is configured (build/config/buildbuddy.bcfg, plan 0036).
  # Without a remote cache, nothing is uploaded. The hermetic toolchains
  # (plan 0035) make the results safe to share. `rust_test` links and most
  # `genrule`s still opt out in the prelude. This key must be here: Buck2
  # ignores it when it comes from buildbuddy.bcfg through .buckconfig.local.
  default_allow_cache_upload = true

[build]
  # The host, and the host in Miri mode; see build/platforms.bzl.
  execution_platforms = root//build:execution-platforms

[project]
  # Cargo's output directory, and tools/gcp-bench's runs (plan 0024); never
  # part of the Buck2 graph. Without the second, every run's staged binaries
  # reset Buck2's file watcher.
  ignore = target, .peppydb-bench
